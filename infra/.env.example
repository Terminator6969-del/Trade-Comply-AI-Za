# TradeComply AI South Africa - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ==================== Database ====================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tradecomply
DB_HOST=db
DB_PORT=5432

# ==================== Security ====================
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0

# ==================== MinIO S3 Storage ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tradecomply-docs

# ==================== AI Providers ====================
# Options: "mock", "azure", "aws", "gcp", "openai"
OCR_PROVIDER=mock
LLM_PROVIDER=mock

# For Azure:
# AZURE_OCR_ENDPOINT=https://<region>.api.cognitive.microsoft.com/
# AZURE_OCR_KEY=your-azure-key

# For AWS:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# For OpenAI (LLM):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4

# ==================== Frontend ====================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development

# ==================== Logging & Monitoring ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=  # Leave empty for development

# ==================== SARS Integration (Future) ====================
# SARS_API_URL=https://...
# SARS_CLIENT_ID=your-client-id
# SARS_CLIENT_SECRET=your-client-secret

# ==================== Email (Future) ====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@tradecomply.ai
